# 실제 값은 .env 에 넣는다 (.gitignore 처리됨). 이 파일은 키 목록만 공유하는 용도.
#
# .env 는 application.properties 의 `spring.config.import` 가 읽는다 — Spring Boot 가
# 자동으로 읽어 주지 않으므로 그 줄이 없으면 파일을 만들어 둬도 조용히 무시된다.
# OS 환경변수가 .env 보다 우선하므로, 잠깐 다른 값으로 띄우려면 export 로 덮으면 된다.

# 호출자 인증. **jobit-front 의 JOBIT_SERVICE_SECRET 과 같은 값이어야 한다.**
# /api/** 가 owner_key 에 붙은 HMAC 서명을 요구한다. 비워 두면 인증이 꺼지고(로컬 전용)
# 부팅 로그에 경고가 남는다. prod 프로파일에서는 비어 있으면 앱이 뜨지 않는다.
#   openssl rand -base64 32
JOBIT_SERVICE_SECRET=

# LLM — JD 파싱, 질문 생성, 답변 채점, 갭 판정, 리라이트 전부 이 키 하나로 처리
#
# **여기만 Spring 프로퍼티 이름을 쓴다** (SHOUT_CASE 가 아니다). AnthropicConfig 의
# @ConditionalOnProperty("anthropic.api-key") 는 그 이름을 그대로 찾는데,
# ANTHROPIC_API_KEY -> anthropic.api-key 완화 바인딩은 **OS 환경변수 소스에만** 적용되고
# properties 로 읽는 .env 에는 적용되지 않는다. SHOUT_CASE 로 적으면 조용히 무시되고
# 폴백이 자리를 지킨다 (부팅 로그에 "JdParser 구현이 없습니다" 가 뜬다).
anthropic.api-key=

# 위 값을 .env 에 넣어도 **LLM 스모크 테스트는 건너뛴다.** 그쪽은 Spring 을 타지 않고
# System.getenv 를 직접 읽기 때문이다. 돌리려면 그때만 export 한다:
#   export ANTHROPIC_API_KEY=sk-ant-...
#   JOBIT_LLM_SMOKE=1 ./gradlew test --tests '*SmokeTest*'

# 임베딩 — Anthropic은 임베딩 모델을 제공하지 않아 별도 제공자가 필요하다.
# 스펙 §3.3의 vector(1536)은 OpenAI text-embedding-3-small 기준.
OPENAI_API_KEY=

# --- 로드맵 3~4단계에서 필요 ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# RESUME_ENCRYPTION_KEY=
