# 실제 값은 .env 에 넣는다 (.gitignore 처리됨). 이 파일은 키 목록만 공유하는 용도.
#
# .env 는 application.properties 의 `spring.config.import` 가 읽는다 — Spring Boot 가
# 자동으로 읽어 주지 않으므로 그 줄이 없으면 파일을 만들어 둬도 조용히 무시된다.
# OS 환경변수가 .env 보다 우선하므로, 잠깐 다른 값으로 띄우려면 export 로 덮으면 된다.

# 호출자 인증. **jobit-front 의 JOBIT_SERVICE_SECRET 과 같은 값이어야 한다.**
# /api/** 가 owner_key 에 붙은 HMAC 서명을 요구한다. 비워 두면 인증이 꺼지고(로컬 전용)
# 부팅 로그에 경고가 남는다. prod 프로파일에서는 비어 있으면 앱이 뜨지 않는다.
#   openssl rand -base64 32
JOBIT_SERVICE_SECRET=

# LLM — JD 파싱, 질문 생성, 답변 채점, 임베딩, 갭 판정, 리라이트 전부 이 서버 하나로 처리한다.
# API 키가 없다. 로컬 Ollama 라 인증 자체가 없고, **외부로 나가는 호출이 하나도 없다.**
#
# **이 줄이 스위치다.** 값이 없으면 JdParser·ResumeParser·AnswerScorer·EmbeddingClient 가
# 전부 폴백으로 등록되고, 앱은 뜨되 해당 기능을 호출하는 순간 명확한 예외가 난다.
# (부팅 로그에 "... 구현이 없습니다" 가 뜬다.) 캐시·이력 로직만 굴려 보고 싶을 때 쓰는 상태다.
#
# **application.properties 에 기본값을 박지 않은 것은 의도다** — 박으면 프로퍼티가 항상
# "있음"이 되어 위 폴백이 영영 물리지 않는다. 그쪽 주석 참고.
#
# 준비:
#   brew install ollama && ollama serve
#   ollama pull qwen3:14b            # 생성 (LlmModelConfig.DEFAULT_MODEL)
#   ollama pull qwen3-embedding:0.6b # 임베딩 — 별개로 받아야 한다
ollama.base-url=http://localhost:11434

# 이력서 원문 암호화 (AES-256-GCM). base64 32바이트.
#
# **비워 두면 이력서 업로드가 거부된다.** 호출자 인증처럼 "꺼진 채로 동작"하지 않는다 —
# 평문으로 저장된 이력서는 나중에 되돌릴 방법이 없기 때문이다.
# prod 프로파일에서는 비어 있으면 앱이 아예 뜨지 않는다.
#   openssl rand -base64 32
JOBIT_RESUME_KEY=

# --- 로드맵 3~4단계에서 필요 ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
